# Terraform working files and state should not be committed.
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Local secret material.
*.tfvars
*.tfvars.json
*.auto.tfvars
*.auto.tfvars.json
*.pem
*.key
*.features.conf
