# Terraform working files and state should not be committed.
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Local secret material.
*.tfvars
*.tfvars.json
*.auto.tfvars
*.auto.tfvars.json
*.pem
*.key

# Python environments and build outputs.
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
build/
dist/
*.egg-info/

# JetBrains IDE project files.
.idea/
*.iml

# VS Code/Cursor workspace settings.
.vscode/
