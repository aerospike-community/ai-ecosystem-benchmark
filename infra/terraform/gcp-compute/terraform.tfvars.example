project_id = "firefly-aerospike"
region     = "us-central1"
zone       = "us-central1-a"

name_prefix = "ai-bench"

enable_aerospike = true
enable_redis     = false
enable_postgres  = false
enable_client    = false

aerospike_namespace = "test"

redis_topology    = "standalone"
postgres_topology = "standalone"

# Password for the Postgres bench user when Postgres is enabled.
postgres_password = "benchpassword"

# Enables the copy-paste "connect from your computer" command in the workflow summary.
enable_local_access = true
