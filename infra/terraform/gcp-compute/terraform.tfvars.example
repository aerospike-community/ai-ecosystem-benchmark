project_id = "firefly-aerospike"
region     = "us-central1"
zone       = "us-central1-a"

name_prefix = "ai-bench"

enable_aerospike = true
enable_redis     = false
enable_postgres  = false

redis_topology    = "standalone"
postgres_topology = "standalone"

# Optional. Leave empty to skip creating a public SSH ingress rule.
allowed_ssh_cidr = ""
